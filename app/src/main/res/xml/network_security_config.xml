<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config — DEV ONLY.
  Allows cleartext HTTP to the local dev machine so the Android emulator/device
  can reach the Express backend. Remove <domain-config> for production.
  Auto-generated by scripts/fix-android.cjs — re-run `npm run android:fix` if IP changes.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android Emulator: 10.0.2.2 always maps to host machine localhost -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Physical device on same Wi-Fi (auto-detected LAN IP: 192.168.1.13) -->
        <domain includeSubdomains="false">192.168.1.13</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
